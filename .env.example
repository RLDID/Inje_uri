# Local PostgreSQL example
# Replace the password and database name for your local environment.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/injeuri?schema=public"

# DB field encryption key (AES-256-GCM)
# Generate with: openssl rand -base64 32
# Keep this value stable. If lost or changed, encrypted DB values cannot be decrypted.
DB_ENCRYPTION_KEY=<openssl_rand_base64_32_result>

# Docker Compose server-test example
# In Docker Compose, use the DB service name instead of localhost.
# DATABASE_URL="postgresql://postgres:postgres@db:5432/injeuri?schema=public"

# Admin page
# Set this only in your local/server .env. Do not commit the real code.
ADMIN_ACCESS_CODE="change-this-admin-code"
# Optional. If omitted, ADMIN_ACCESS_CODE is used to sign admin sessions.
ADMIN_SESSION_SECRET="change-this-admin-session-secret"

# Google Analytics 4
# Paste the GA4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Microsoft Clarity
# Paste the Clarity project ID, e.g. abc123xyz.
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Waiting page bypass
# Set to true only on local/staging test deployments that should access the app before launch.
WAITING_BYPASS="false"
